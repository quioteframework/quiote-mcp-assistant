{
    "name": "quioteframework/quiote-mcp-assistant",
    "description": "MCP server giving AI agents authoritative knowledge of, and read-only/scaffolding access to, Quiote applications.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "quioteframework/quiote": "^4.0",
        "quioteframework/mcp": "^4.0",
        "quioteframework/csrf": "^4.0",
        "quioteframework/replay": "*",
        "quioteframework/replay-azure": "*",
        "quioteframework/replay-storage": "*",
        "quioteframework/cloud-azure": "*",
        "quioteframework/storage": "*",
        "mcp/sdk": "^0.7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote/packages/replay",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote/packages/replay-azure",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote/packages/replay-storage",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote/packages/cloud-azure",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "/home/markus/Projects/quiote/packages/storage",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "QuioteMcpAssistant\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuioteMcpAssistant\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/quiote-assistant"
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "quioteframework/phptal": "^4.0",
        "quioteframework/xslt": "^4.0",
        "quioteframework/twig": "^4.0"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --configuration=phpstan.neon"
    }
}
